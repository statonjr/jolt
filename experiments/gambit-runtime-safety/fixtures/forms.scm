(define (names n prefix)
  (let loop ((i 0) (out '()))
    (if (= i n) (reverse out)
        (loop (+ i 1)
              (cons (string->symbol (string-append prefix (number->string i))) out)))))
(define (parameters mode n)
  (case mode
    ((positional) (names n "p"))
    ((optional) (cons '#!optional (names n "o")))
    ((keyword) (cons '#!key (names n "k")))
    ((rest) (append (names (- n 1) "p") 'r))
    ((mixed) (append (names 20 "p") (list '#!optional) (names 20 "o")
                     (list '#!rest 'r '#!key) (names (- n 41) "k")))
    (else (error "Unknown parameter mode" mode))))
(define (lambda-form mode n)
  (list 'lambda (parameters mode n) n))
