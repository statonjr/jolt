(define passed 0)
(define failed 0)
(define env (interaction-environment))
(define (attempt thunk)
  (with-exception-catcher
   (lambda (e)
     (cond ((number-of-arguments-limit-exception? e) 'argument-limit)
           ((expression-parsing-exception? e)
            (list 'parsing (expression-parsing-exception-kind e)
                  (expression-parsing-exception-parameters e)))
           (else (display-exception e) 'unexpected-condition)))
   (lambda () (list 'value (thunk)))))
(define (assert-outcome label expected actual)
  (if (equal? expected actual)
      (begin (set! passed (+ passed 1)) (write (list 'PASS label actual)))
      (begin (set! failed (+ failed 1))
             (write (list 'FAIL label 'expected expected 'actual actual))))
  (newline)
  (force-output))
(define (check label expected thunk)
  (assert-outcome label expected (attempt thunk))
  (assert-outcome (list 'recovery label) '(value 42)
                  (attempt (lambda () (eval '(+ 20 22) env)))))
(define (indices n)
  (let loop ((i (- n 1)) (xs '()))
    (if (< i 0) xs (loop (- i 1) (cons i xs)))))
(define (key-name i)
  (string-append "k" (number->string i)))
(define key-vars (map (lambda (i) (string->symbol (key-name i))) (indices 32)))
(define (key-args order)
  (let loop ((is order))
    (if (null? is) '()
        (cons (string->keyword (key-name (car is)))
              (cons (car is) (loop (cdr is)))))))
(eval (list 'define 'keyword-probe
            (list 'lambda (cons #!key key-vars) (cons '+ key-vars))) env)
(eval (list 'define 'keyword-prefix-probe
            (list 'lambda (cons 'prefix (cons #!key key-vars)) (cons '+ key-vars))) env)
(define keyword-probe-value (eval 'keyword-probe env))
(define keyword-prefix-probe-value (eval 'keyword-prefix-probe env))
(for-each
 (lambda (order)
   (let ((args (key-args order)))
     (check (list 'keyword-source-64 (car order)) '(value 496)
            (lambda () (eval (cons 'keyword-probe args) env)))
     (check (list 'keyword-apply-64 (car order)) '(value 496)
            (lambda () (apply keyword-probe-value args)))))
 (list (indices 32) (reverse (indices 32))))
(check 'keyword-source-65
       '(parsing ill-formed-call ("Public argument limit is 64"))
       (lambda () (eval (cons 'keyword-prefix-probe (cons 0 (key-args (indices 32)))) env)))
(check 'keyword-apply-65 'argument-limit
       (lambda () (apply keyword-prefix-probe-value 0 (key-args (indices 32)))))
(define (live-rest . xs)
  (##gc)
  (and (= (length xs) 64)
       (let loop ((ys xs) (n 0))
         (if (null? ys) (= n 64)
             (and (= (vector-ref (car ys) 0) n)
                  (= (vector-length (car ys)) 256)
                  (loop (cdr ys) (+ n 1)))))))
(check 'gc-live-rest-100 '(value #t)
  (lambda ()
    (let loop ((n 100))
      (if (= n 0) #t
          (and (apply live-rest (map (lambda (i) (make-vector 256 i)) (indices 64)))
               (loop (- n 1)))))))
(check 'apply-overflow-gc-recovery-100 '(value #t)
  (lambda ()
    (let loop ((n 100))
      (if (= n 0) #t
          (let ((rejection (attempt (lambda () (apply list (make-list 65 n))))))
            (##gc)
            (and (eq? rejection 'argument-limit)
                 (= (length (apply list (make-list 64 n))) 64)
                 (loop (- n 1))))))))
(check 'dynamic-wind-overflow-cleanup '(value (argument-limit (before after)))
  (lambda ()
    (let ((events '()))
      (let ((outcome
             (attempt
              (lambda ()
                (dynamic-wind
                 (lambda () (set! events (cons 'before events)))
                 (lambda () (apply list (make-list 65 1)))
                 (lambda () (set! events (cons 'after events))))))))
        (list outcome (reverse events))))))
(define (continuation-probe)
  (let ((saved #f) (phase 0) (events '()))
    (let ((answer
           (dynamic-wind
            (lambda () (set! events (cons 'before events)))
            (lambda ()
              (apply
               (lambda xs
                 (let ((n (call-with-current-continuation
                           (lambda (k) (set! saved k) 7))))
                   (##gc)
                   (list n (length xs) (car xs) (car (reverse xs)))))
               (indices 64)))
            (lambda () (set! events (cons 'after events))))))
      (if (= phase 0)
          (begin (set! phase 1) (##gc) (saved 9))
          (list answer (reverse events))))))
(check 'continuation-rest-gc-reentry
       '(value ((9 64 0 63) (before after before after))) continuation-probe)
(check 'continuation-reentry-100 '(value #t)
  (lambda ()
    (let loop ((n 100))
      (if (= n 0) #t
          (and (equal? (continuation-probe)
                       '((9 64 0 63) (before after before after)))
               (loop (- n 1)))))))
(check 'internal-escape-link-64 '(value 64)
       (lambda () (string-length (##escape-link (make-string 64 #\a)))))
(check 'internal-escape-link-65 (list 'value (make-string 65 #\a))
       (lambda () (##escape-link (make-string 65 #\a))))
(eval '(define-macro (discard . xs) 7) env)
(check 'macro-input-64 '(value 7)
       (lambda () (eval (cons 'discard (make-list 64 0)) env)))
(check 'macro-input-65 'argument-limit
       (lambda () (eval (cons 'discard (make-list 65 0)) env)))
(write (list 'SUMMARY 'passed passed 'failed failed))
(newline)
(exit (if (= failed 0) 0 1))
