(define passed 0)
(define failed 0)
(define (check xs high low)
  (let ((h (c#highest xs)) (l (c#lowest xs)))
    (if (and (equal? h high) (equal? l low))
        (set! passed (+ passed 1))
        (begin (set! failed (+ failed 1)) (write (list 'FAIL xs h l)) (newline)))))
(check '() #f #f)
(check '(7) 7 7)
(check '(-5 -2 -9 -2) -2 -9)
(check '(3 0 5 1) 5 0)
(check (make-list 65 8) 8 8)
(check (let loop ((i 256) (xs '())) (if (< i 0) xs (loop (- i 1) (cons i xs)))) 256 0)
(write (list 'EXTREMA 'passed passed 'failed failed))
(newline)
(exit (if (= failed 0) 0 1))
