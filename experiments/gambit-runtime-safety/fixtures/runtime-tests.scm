(##include "forms.scm")
(define passed 0)
(define failed 0)
(define (rest-count . xs) (length xs))
(define env (interaction-environment))
(define (attempt thunk)
  (with-exception-catcher
   (lambda (e)
     (cond ((number-of-arguments-limit-exception? e) 'argument-limit)
           ((wrong-number-of-arguments-exception? e) 'wrong-arity)
           ((type-exception? e) 'type-error)
           ((expression-parsing-exception? e)
            (list 'parsing (expression-parsing-exception-kind e)
                  (expression-parsing-exception-parameters e)))
           (else (display-exception e) 'unexpected-condition)))
   (lambda () (list 'value (thunk)))))
(define (assert-outcome label expected actual)
  (if (equal? expected actual)
      (begin (set! passed (+ passed 1)) (write (list 'PASS label actual)))
      (begin (set! failed (+ failed 1))
             (write (list 'FAIL label 'expected expected 'actual actual))))
  (newline)
  (force-output))
(define (check label expected thunk)
  (assert-outcome label expected (attempt thunk))
  (assert-outcome (list 'recovery label) '(value 42)
                  (attempt (lambda () (eval '(+ 20 22) env)))))
(define call-limit '(parsing ill-formed-call ("Public argument limit is 64")))
(define slot-limit '(parsing ill-formed-expression ("Public parameter slot limit is 64")))
(for-each
 (lambda (n)
   (let ((xs (make-list n 1)))
     (check (list 'direct n) (if (= n 64) '(value 64) call-limit)
            (lambda () (eval (cons 'rest-count xs) env)))
     (for-each
      (lambda (mode)
        (check (list 'slots mode n) (if (= n 64) '(value #t) slot-limit)
               (lambda () (procedure? (eval (lambda-form mode n) env)))))
      '(positional optional keyword rest mixed))
     (for-each
      (lambda (prefix)
        (check (list 'apply prefix n) (if (= n 64) '(value 64) 'argument-limit)
          (lambda ()
            (case prefix
              ((0) (apply rest-count xs))
              ((1) (apply rest-count 1 (make-list (- n 1) 1)))
              ((3) (apply rest-count 1 1 1 (make-list (- n 3) 1)))))))
      '(0 1 3))
     (check (list 'kernel-apply n) (if (= n 64) '(value 64) 'argument-limit)
            (lambda () (##apply rest-count xs)))
     (check (list 'dynamic-values n) (if (= n 64) '(value 64) 'argument-limit)
       (lambda () (call-with-values (lambda () (apply values xs)) rest-count)))
     (check (list 'wrong-arity n) (if (= n 64) 'wrong-arity 'argument-limit)
            (lambda () (apply (lambda (x) x) xs)))
     (check (list 'type-error n) (if (= n 64) 'type-error 'argument-limit)
            (lambda () (apply + (make-list n #f))))
     (eval (list 'define-macro '(expanded-call)
                 (list 'quote (cons 'rest-count xs))) env)
     (check (list 'macro-expanded n) (if (= n 64) '(value 64) call-limit)
            (lambda () (eval '(expanded-call) env)))))
 '(64 65))
(for-each
 (lambda (mode)
   (check (list 'invoke-slots mode 64) '(value 64)
     (lambda ()
       (let ((p (eval (lambda-form mode 64) env)))
         (case mode
           ((positional rest) (apply p (make-list 64 1)))
           ((optional keyword) (p))
           ((mixed) (apply p (make-list 20 1))))))))
 '(positional optional keyword rest mixed))
(check 'malformed-call '(parsing ill-formed-call ())
       (lambda () (eval '(rest-count . bad) env)))
(check 'duplicate-parameter '(parsing duplicate-parameter ())
       (lambda () (eval '(lambda (x x) x) env)))
(write (list 'SUMMARY 'passed passed 'failed failed))
(newline)
(exit (if (= failed 0) 0 1))
